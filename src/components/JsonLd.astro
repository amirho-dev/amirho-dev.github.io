---
/**
 * Renders one or more schema.org JSON-LD blocks (§8).
 * Data is hardened by escaping "<" so no string value can ever
 * terminate the <script> element early.
 */
interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { schema } = Astro.props;

const blocks = (Array.isArray(schema) ? schema : [schema]).map((entry) =>
  JSON.stringify(entry).replace(/</g, "\\u003c"),
);
---

{blocks.map((json) => <script type="application/ld+json" set:html={json} />)}
