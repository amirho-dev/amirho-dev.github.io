---
import type { LocaleCode } from "../i18n/config";
import { t } from "../i18n/utils";
import { SITE } from "../config/site";
import Button from "./Button.astro";

/**
 * Contact form (§10.6, §11 Phase 11) — ONE form, TWO fully-coded
 * delivery paths selected by the environment:
 *
 *  · http  — PUBLIC_FORM_ENDPOINT set (Web3Forms access key): submit
 *    via fetch with sending/success/error states.
 *  · mailto — endpoint absent: the same validated fields compose a
 *    prefilled mailto: (subject + body) and open the visitor's mail
 *    app; the fallback panel explains it. No network calls, no fake
 *    keys, no stub UI.
 *
 * Validation is shared by both paths (same rules, same translated
 * messages) and is fully client-side with novalidate + custom messages:
 *  · name required · email required + format · message required + ≥20 chars
 *  · subject optional (prefills the mailto subject when filled)
 * All copy comes from the dictionaries; the client script reads every
 * message from data attributes, so it never bundles them.
 * A hidden "botcheck" honeypot silently swallows bot submissions.
 */
interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const dict = t(locale);
const isFa = locale === "fa";

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const isHttp = Boolean(endpoint);

const labelClass = isFa
  ? "mb-2 block text-sm font-medium"
  : "mb-2 block mono-label";
const fieldClass =
  "min-h-11 w-full rounded-lg border border-hairline bg-surface px-4 py-2.5 text-text transition-colors duration-200 placeholder:text-muted/70 focus:border-accent aria-[invalid=true]:border-danger";
---

<form
  data-contact-form
  data-mode={isHttp ? "http" : "mailto"}
  data-endpoint={endpoint ?? ""}
  data-email={SITE.email}
  data-msg-success={dict.contact.success}
  data-msg-error={dict.contact.error}
  data-msg-invalid={dict.a11y.formErrors}
  data-msg-sending={dict.contact.sending}
  novalidate
  class="flex flex-col gap-6 rounded-xl border border-hairline bg-surface p-6 shadow-card md:p-8"
>
  <h2 class="font-display text-xl">{dict.contact.formTitle}</h2>

  <div
    data-form-status
    class="hidden rounded-lg border p-4 text-sm"
    role="status"
    aria-live="polite"
  >
    <p class="flex items-start gap-2.5">
      <svg
        data-icon-ok
        class="hidden size-4 shrink-0 translate-y-0.5 text-ok"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
      <svg
        data-icon-err
        class="hidden size-4 shrink-0 translate-y-0.5 text-danger"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 8v5m0 3.5v.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"></path>
      </svg>
      <span data-status-message></span>
    </p>
  </div>

  <div class="flex flex-col gap-5 sm:flex-row">
    <div class="flex-1">
      <label for="contact-name" class={labelClass}
        >{dict.contact.nameLabel}</label
      >
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        placeholder={dict.contact.namePlaceholder}
        class={fieldClass}
        aria-describedby="contact-name-error"
        data-field
        data-msg-required={dict.contact.errNameRequired}
      />
      <p
        id="contact-name-error"
        data-error-for="name"
        class="mt-2 hidden text-sm text-danger"
      >
      </p>
    </div>

    <div class="flex-1">
      <label for="contact-email" class={labelClass}
        >{dict.contact.emailLabel}</label
      >
      {
        /* Email content is Latin — pinned LTR (standard pattern for
          address inputs); alignment stays logical. */
      }
      <input
        id="contact-email"
        name="email"
        type="email"
        dir="ltr"
        autocomplete="email"
        required
        placeholder={dict.contact.emailPlaceholder}
        class={fieldClass}
        aria-describedby="contact-email-error"
        data-field
        data-msg-required={dict.contact.errEmailRequired}
        data-msg-invalid={dict.contact.errEmailInvalid}
      />
      <p
        id="contact-email-error"
        data-error-for="email"
        class="mt-2 hidden text-sm text-danger"
      >
      </p>
    </div>
  </div>

  <div>
    <label for="contact-subject" class={labelClass}
      >{dict.contact.subjectLabel}</label
    >
    <input
      id="contact-subject"
      name="subject"
      type="text"
      placeholder={dict.contact.subjectPlaceholder}
      class={fieldClass}
      data-field
    />
  </div>

  <div>
    <label for="contact-message" class={labelClass}
      >{dict.contact.messageLabel}</label
    >
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      required
      placeholder={dict.contact.messagePlaceholder}
      class:list={[fieldClass, "min-h-32 resize-y py-3"]}
      aria-describedby="contact-message-error"
      data-field
      data-msg-required={dict.contact.errMessageRequired}
      data-msg-short={dict.contact.errMessageShort}></textarea>
    <p
      id="contact-message-error"
      data-error-for="message"
      class="mt-2 hidden text-sm text-danger"
    >
    </p>
  </div>

  {
    /* Honeypot — humans never see it; bots that fill it are silently discarded. */
  }
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  {
    !isHttp && (
      <div class="rounded-lg border border-hairline bg-surface-2/50 p-4">
        <p class="font-medium">{dict.contact.fallbackTitle}</p>
        <p class="mt-1 text-sm text-muted">{dict.contact.fallbackText}</p>
      </div>
    )
  }

  <Button type="submit" class="self-start">
    <span data-submit-label
      >{isHttp ? dict.contact.submit : dict.contact.fallbackButton}</span
    >
    {
      !isHttp && (
        <svg
          class="size-4 rtl:-scale-x-100"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M22 2 11 13" />
          <path d="M22 2 15 22l-4-9-9-4 20-7z" />
        </svg>
      )
    }
  </Button>
</form>

<script>
  type FieldName = "name" | "email" | "subject" | "message";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const mode: "http" | "mailto" =
      form.dataset.mode === "http" ? "http" : "mailto";
    const endpoint = form.dataset.endpoint ?? "";
    const siteEmail = form.dataset.email ?? "";

    const statusBox = form.querySelector<HTMLElement>("[data-form-status]");
    const statusMessage = form.querySelector<HTMLElement>(
      "[data-status-message]",
    );
    const iconOk = form.querySelector<SVGElement>("svg[data-icon-ok]");
    const iconErr = form.querySelector<SVGElement>("svg[data-icon-err]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const submitButton = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const restingLabel = submitLabel?.textContent ?? "";

    const fields: Record<
      FieldName,
      HTMLInputElement | HTMLTextAreaElement | null
    > = {
      name: form.querySelector<HTMLInputElement>('[name="name"]'),
      email: form.querySelector<HTMLInputElement>('[name="email"]'),
      subject: form.querySelector<HTMLInputElement>('[name="subject"]'),
      message: form.querySelector<HTMLTextAreaElement>('[name="message"]'),
    };

    const errorBox = (name: FieldName): HTMLElement | null =>
      form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);

    // ── validation ────────────────────────────────────────────────
    const validateField = (name: FieldName): string | null => {
      const input = fields[name];
      if (!input) return null;
      const value = input.value.trim();

      if (input.required && value === "")
        return input.dataset.msgRequired ?? null;

      if (
        name === "email" &&
        value !== "" &&
        !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)
      ) {
        return input.dataset.msgInvalid ?? null;
      }

      if (name === "message" && value !== "" && value.length < 20) {
        return input.dataset.msgShort ?? null;
      }

      return null;
    };

    const setFieldError = (name: FieldName, message: string | null): void => {
      const input = fields[name];
      const box = errorBox(name);
      if (!input || !box) return;
      if (message) {
        box.textContent = message;
        box.classList.remove("hidden");
        input.setAttribute("aria-invalid", "true");
      } else {
        box.textContent = "";
        box.classList.add("hidden");
        input.removeAttribute("aria-invalid");
      }
    };

    /** Validates everything; returns the first invalid field (or null). */
    const validateAll = (): FieldName | null => {
      let firstInvalid: FieldName | null = null;
      (Object.keys(fields) as FieldName[]).forEach((name) => {
        const message = validateField(name);
        setFieldError(name, message);
        if (message && firstInvalid === null) firstInvalid = name;
      });
      return firstInvalid;
    };

    // ── status banner ─────────────────────────────────────────────
    const STATUS_OK = ["border-ok/50", "bg-ok/10"];
    const STATUS_ERR = ["border-danger/50", "bg-danger/10"];

    const showStatus = (kind: "ok" | "err", message: string): void => {
      if (!statusBox || !statusMessage) return;
      statusBox.classList.remove("hidden", ...STATUS_OK, ...STATUS_ERR);
      statusBox.classList.add(...(kind === "ok" ? STATUS_OK : STATUS_ERR));
      if (iconOk) iconOk.classList.toggle("hidden", kind !== "ok");
      if (iconErr) iconErr.classList.toggle("hidden", kind !== "err");
      statusMessage.textContent = message;
    };

    const hideStatus = (): void => {
      statusBox?.classList.add("hidden");
      if (statusMessage) statusMessage.textContent = "";
    };

    // ── mailto composer (fallback path, §10.6) ────────────────────
    const buildMailto = (): string => {
      const name = fields.name?.value.trim() ?? "";
      const subject = fields.subject?.value.trim() ?? "";
      const body = [
        fields.message?.value ?? "",
        "",
        `— ${name}`,
        fields.email?.value.trim() ?? "",
      ].join("\n");

      const params: string[] = [];
      if (subject) params.push(`subject=${encodeURIComponent(subject)}`);
      params.push(`body=${encodeURIComponent(body)}`);
      return `mailto:${siteEmail}?${params.join("&")}`;
    };

    // ── sending state (http path) ─────────────────────────────────
    let sending = false;

    const setSending = (state: boolean): void => {
      sending = state;
      if (submitButton) submitButton.disabled = state;
      if (submitLabel)
        submitLabel.textContent = state
          ? (form.dataset.msgSending ?? "")
          : restingLabel;
    };

    // ── submit ────────────────────────────────────────────────────
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (sending) return;

      hideStatus();
      const firstInvalid = validateAll();
      if (firstInvalid) {
        showStatus("err", form.dataset.msgInvalid ?? "");
        fields[firstInvalid]?.focus();
        return;
      }

      // Honeypot tripped → silently pretend success, send nothing.
      const honeypot = form.querySelector<HTMLInputElement>(
        'input[name="botcheck"]',
      );
      if (honeypot?.checked) {
        showStatus("ok", form.dataset.msgSuccess ?? "");
        form.reset();
        return;
      }

      if (mode === "mailto") {
        window.location.href = buildMailto();
        return;
      }

      setSending(true);
      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({
            access_key: endpoint,
            name: fields.name?.value.trim() ?? "",
            email: fields.email?.value.trim() ?? "",
            subject: fields.subject?.value.trim() ?? "",
            message: fields.message?.value ?? "",
          }),
        });
        const data = (await response.json()) as { success?: boolean };
        if (response.ok && data.success === true) {
          showStatus("ok", form.dataset.msgSuccess ?? "");
          form.reset();
        } else {
          showStatus("err", form.dataset.msgError ?? "");
        }
      } catch {
        showStatus("err", form.dataset.msgError ?? "");
      } finally {
        setSending(false);
      }
    });

    // Editing a field clears its error immediately.
    (Object.keys(fields) as FieldName[]).forEach((name) => {
      fields[name]?.addEventListener("input", () => setFieldError(name, null));
    });
  }
</script>
