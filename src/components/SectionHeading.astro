---
/**
 * Section header with the terminal-style `$ ls ~/…` eyebrow.
 *
 *  · `path` is ALWAYS Latin (a filesystem-ish segment: "projects",
 *    "blog"…) — the eyebrow is mono/terminal flavor and never localized
 *    (§7.4); it is aria-hidden because the real heading follows it.
 *  · `headingLevel` supports h1 for pages whose title IS the page
 *    heading (index/about/contact/lab) — enforcing one h1 per page (§8).
 *    Section headings inside a page use the h2 default.
 *  · The optional link is pre-localized by the caller (final href +
 *    final label); its arrow mirrors under RTL.
 */
interface Props {
  /** Latin eyebrow path segment, e.g. 'projects'. Never localized. */
  path: string;
  /** Localized section title. */
  title: string;
  /** Optional localized subtitle. */
  subtitle?: string;
  /** Optional "view all"-style link (already localized). */
  link?: { href: string; label: string };
  /** Heading level — h2 by default, h1 when this is the page heading. */
  headingLevel?: 1 | 2 | 3;
  class?: string;
}

const {
  path,
  title,
  subtitle,
  link,
  headingLevel = 2,
  class: className,
} = Astro.props;

const Heading = headingLevel === 1 ? "h1" : headingLevel === 3 ? "h3" : "h2";
---

<div
  class:list={[
    "flex flex-wrap items-end justify-between gap-x-6 gap-y-4",
    className,
  ]}
>
  <div class="max-w-2xl">
    <p class="mono-label mb-3 text-accent" aria-hidden="true">$ ls ~/{path}</p>
    <Heading class="text-3xl md:text-4xl">{title}</Heading>
    {subtitle && <p class="mt-3 text-muted">{subtitle}</p>}
  </div>

  {
    link && (
      <a
        href={link.href}
        class="inline-flex min-h-11 items-center gap-2 mono-label text-muted transition-colors duration-200 hover:text-accent"
      >
        {link.label}
        <svg
          class="size-4 rtl:-scale-x-100"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    )
  }
</div>
