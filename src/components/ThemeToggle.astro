---
import type { LocaleCode } from "../i18n/config";
import { t } from "../i18n/utils";

/**
 * Dark/light toggle (§6.4). Dark is the markup default; clicking removes
 * `.dark` for light. The choice persists to localStorage under
 * 'amirho:theme' — the same key the no-flash script in BaseLayout reads.
 * The visible icon always previews the theme you'll switch TO, and the
 * aria-label always names the action — both re-synced on load and click.
 */
interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<button
  type="button"
  data-theme-toggle
  data-label-dark={dict.a11y.themeToggleDark}
  data-label-light={dict.a11y.themeToggleLight}
  class="flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-hairline text-muted transition-colors duration-200 hover:border-hairline-strong hover:text-text"
  aria-label={dict.a11y.themeToggleLight}
>
  <!-- sun — shown in dark mode (action: switch to light) -->
  <svg
    class="hidden size-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
    ></path>
  </svg>
  <!-- moon — shown in light mode (action: switch to dark) -->
  <svg
    class="size-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script>
  // Theme engine: toggle, persist, re-label, and keep the browser chrome
  // color in sync with the active --bg token. Binds to every
  // [data-theme-toggle] on the page (header bar + mobile overlay).
  const STORAGE_KEY = "amirho:theme";

  type Theme = "dark" | "light";

  const currentTheme = (): Theme =>
    document.documentElement.classList.contains("dark") ? "dark" : "light";

  const syncMetaThemeColor = (): void => {
    const bg = getComputedStyle(document.documentElement)
      .getPropertyValue("--bg")
      .trim();
    if (!bg) return;
    let meta = document.querySelector<HTMLMetaElement>(
      'meta[name="theme-color"]',
    );
    if (!meta) {
      meta = document.createElement("meta");
      meta.setAttribute("name", "theme-color");
      document.head.appendChild(meta);
    }
    meta.setAttribute("content", bg);
  };

  const applyLabels = (): void => {
    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
      .forEach((button) => {
        const label =
          currentTheme() === "dark"
            ? button.dataset.labelLight
            : button.dataset.labelDark;
        if (label) button.setAttribute("aria-label", label);
      });
  };

  const setTheme = (theme: Theme): void => {
    document.documentElement.classList.toggle("dark", theme === "dark");
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch {
      /* private mode — the toggle still works for this page view */
    }
    applyLabels();
    syncMetaThemeColor();
  };

  document
    .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        setTheme(currentTheme() === "dark" ? "light" : "dark");
      });
    });

  // Align labels + chrome color with whatever the no-flash script applied.
  applyLabels();
  syncMetaThemeColor();
</script>
