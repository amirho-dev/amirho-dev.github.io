---
/**
 * Mono tech chip for stack lists and blog tags.
 * Labels are Latin by contract (tech names, §7.4) — `dir="ltr"` pins
 * them inside RTL pages. Full `text-text` color keeps ≥4.5:1 contrast
 * on the tinted chip background in both themes.
 */
interface Props {
  /** Latin tech/tag label, e.g. 'Next.js'. */
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-md border border-hairline bg-surface-2/60 px-2.5 py-1 font-mono text-xs text-text",
    className,
  ]}
  dir="ltr"
>
  {label}
</span>
