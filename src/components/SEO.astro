---
import { localeConfigs, type LocaleCode } from "../i18n/config";
import { getAlternates, t } from "../i18n/utils";
import { SITE } from "../config/site";

/**
 * Head meta for every page (§8): unique title + description, canonical,
 * full hreflang set (en / fa / x-default→en), Open Graph with locale
 * alternates and the per-locale OG image, Twitter card, and RSS
 * autodiscovery links for both locale feeds.
 *
 * The OG images (/og-en.png, /og-fa.png) are build artifacts produced
 * by `npm run og:generate` (Phase 13) — referenced as URLs, so the
 * build is green before they exist.
 */
interface Props {
  locale: LocaleCode;
  /** Fully-localized page title. */
  title: string;
  /** Fully-localized meta description (~150–160 chars). */
  description: string;
  /** Open Graph type — 'article' on blog posts, 'website' everywhere else. */
  ogType?: "website" | "article";
  /** Image path override; defaults to the locale's static OG image. */
  ogImage?: string;
}

const { locale, title, description, ogType = "website", ogImage } = Astro.props;

const cfg = localeConfigs[locale];
const otherLocale: LocaleCode = locale === "en" ? "fa" : "en";
const dict = t(locale);

const siteUrl = Astro.site?.href ?? Astro.url.origin;
const path = Astro.url.pathname;
const canonical = new URL(path, siteUrl).href;
const alternates = getAlternates(path, siteUrl);

const image = new URL(
  ogImage ?? (locale === "fa" ? "/og-fa.png" : "/og-en.png"),
  siteUrl,
).href;
// The OG artwork shows the site name + roles; the localized home title
// describes it accurately in both languages.
const imageAlt = dict.meta.home.title;

const rssFeeds = [
  { href: new URL("/rss.xml", siteUrl).href, title: t("en").meta.rss.title },
  { href: new URL("/fa/rss.xml", siteUrl).href, title: t("fa").meta.rss.title },
];
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.name} />
<link rel="canonical" href={canonical} />
{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.url} />
  ))
}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={cfg.ogLocale} />
<meta
  property="og:locale:alternate"
  content={localeConfigs[otherLocale].ogLocale}
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{
  rssFeeds.map((feed) => (
    <link
      rel="alternate"
      type="application/rss+xml"
      title={feed.title}
      href={feed.href}
    />
  ))
}
