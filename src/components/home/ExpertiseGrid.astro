---
import type { LocaleCode } from "../../i18n/config";
import { t } from "../../i18n/utils";
import SectionHeading from "../SectionHeading.astro";

/**
 * The six disciplines — data lives in the dictionaries
 * (`home.expertiseItems`), written per locale in Phase 2. Only the
 * mono index numbers are Latin (terminal flavor, §7.4).
 */
interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="container-site py-16 md:py-24">
  <SectionHeading
    path="expertise"
    title={dict.home.expertiseTitle}
    subtitle={dict.home.expertiseSubtitle}
    class="mb-10 md:mb-14"
  />
  <div data-reveal-group class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      dict.home.expertiseItems.map((item, index) => (
        <article
          data-reveal-item
          class="flex flex-col gap-3 rounded-xl border border-hairline bg-surface p-6 shadow-card"
        >
          <p class="mono-label text-accent" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </p>
          <h3 class="font-display text-xl">{item.title}</h3>
          <p class="text-sm text-muted">{item.text}</p>
        </article>
      ))
    }
  </div>
</section>
