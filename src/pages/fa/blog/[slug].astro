---
import { getCollection, render } from "astro:content";
import BlogPostLayout from "../../../layouts/BlogPostLayout.astro";
import type { LocaleCode } from "../../../i18n/config";

/**
 * Blog post (FA mirror, §9) — renders the paired FA MDX with the same
 * BlogPostLayout; slug pairing key shared with the EN route.
 */
const locale: LocaleCode = "fa";

export async function getStaticPaths() {
  const entries = await getCollection(
    "blog",
    ({ data }) => data.locale === "fa" && !data.draft,
  );
  return entries.map((entry) => ({
    params: { slug: entry.id.split("/")[1] ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Chronological walk (ascending pubDate):
// «قبلی» = نوشته‌ی قدیمی‌تر، «بعدی» = نوشته‌ی جدیدتر.
const timeline = (
  await getCollection("blog", ({ data }) => data.locale === "fa" && !data.draft)
).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const index = timeline.findIndex((candidate) => candidate.id === entry.id);
const prev = index > 0 ? timeline[index - 1] : undefined;
const next =
  index >= 0 && index < timeline.length - 1 ? timeline[index + 1] : undefined;
---

<BlogPostLayout
  entry={entry}
  locale={locale}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
</BlogPostLayout>

<script>
  import { initReveals } from "../../../lib/reveal";
  initReveals();
</script>
